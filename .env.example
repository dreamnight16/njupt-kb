# ============================================
# 开发环境变量模板：cp .env.example .env
# 生产环境见 .env.production
# ============================================

ENV=dev
PUBLIC_BASE_URL=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_USER=njupt
POSTGRES_PASSWORD=njupt
POSTGRES_DB=njupt_kb

# --- 会话密钥：开发留空则每次启动随机生成；生产必须显式配置 ---
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- 对象存储（开发为 compose 内的 MinIO）---
MINIO_ROOT_USER=njupt
MINIO_ROOT_PASSWORD=njupt-dev-secret
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=njupt
S3_SECRET_ACCESS_KEY=njupt-dev-secret
S3_BUCKET_QUARANTINE=njupt-quarantine
S3_BUCKET_PRIVATE=njupt-private
# 头像等公开静态资源桶；minio-init 已设为匿名可读
S3_BUCKET_PUBLIC=njupt-public
# 公开资源对外前缀（CDN）；留空则用 S3_PUBLIC_ENDPOINT_URL + 桶名
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# --- 内容安全检查 ---
# clamav: 需要 docker compose --profile scan up -d；disabled 时文件停留在隔离区，不可发布
SCANNER=clamav
CLAMD_HOST=clamav
CLAMD_PORT=3310

# --- beta11 预览与限流：数值是可调默认值，非最终运营策略 ---
PREVIEW_IMAGE_ENABLED=true
PREVIEW_IMAGE_WIDTH=1200
PREVIEW_IMAGE_QUALITY=82
PREVIEW_WATERMARK_ENABLED=true
PREVIEW_WATERMARK_OPACITY=28
# 预览签名 URL 短期化：缩短"持有即用"的临时凭据暴露窗口（prevew.md §十二）
PREVIEW_URL_TTL_SECONDS=300
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
MAX_DOCUMENT_PAGES=1000
MAX_IMAGE_PIXELS=25000000
MAX_ARCHIVE_ENTRIES=2000
MAX_ARCHIVE_UNPACKED_BYTES=262144000
# 每类动作可用 JSON 覆盖角色限额；0 表示不限制（非下载业务配额）。
# RATE_LIMIT_SEARCH={"anon":30,"user":60,"contributor":60,"reviewer":60,"admin":120}

# --- 邮件：开发关闭，验证与找回密码令牌会写入结构化日志 ---
MAIL_ENABLED=false
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- 阶段开关（§6）：关闭时相关接口返回 FEATURE_NOT_ENABLED，不做假成功 ---
COMMERCE_ENABLED=false
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# AI Gateway 启用前边界（AI_ENABLED=true 时生效；默认均为可调默认值，非最终策略）
AI_GATEWAY_TIMEOUT_SECONDS=5
AI_GATEWAY_FAILURE_THRESHOLD=5
AI_GATEWAY_COOLDOWN_SECONDS=30
AI_REQUEST_MAX_TOKENS=4000
AI_REQUEST_MAX_CALLS=4

# --- beta13 治理队列防滥用：按用户维度，避免单一账号刷爆治理队列 ---
COMMENT_REPORT_RATE_LIMIT=10
COMMENT_REPORT_RATE_WINDOW_SECONDS=3600
COMMENT_REPORT_OPEN_CAP=20
COMMENT_APPEAL_RATE_LIMIT=5
COMMENT_APPEAL_RATE_WINDOW_SECONDS=3600
COMMENT_APPEAL_OPEN_CAP=5
# 只读运营告警阈值：GET /admin/alerts 达到即 warning，达阈值*CRITICAL_MULTIPLIER 为 critical；只展示不自动处置
OPS_ALERT_OPEN_REPORTS=50
OPS_ALERT_PENDING_REVIEWS=30
OPS_ALERT_OPEN_CORRECTIONS=30
OPS_ALERT_OPEN_REQUESTS=50
OPS_ALERT_FAILED_JOBS=20
OPS_ALERT_FAILED_EVENTS=20
OPS_ALERT_CRITICAL_MULTIPLIER=3
# 注销账号保留期为代码常量（identity/service.py 的 ACCOUNT_RETENTION_DAYS=30），非环境变量

# --- beta14 身份与会话安全：均为可调默认值，非最终运营策略 ---
# 单账号并发活跃会话上限；0 表示不限。超限时本次登录仍成功，仅淘汰最旧会话
SESSION_MAX_ACTIVE_PER_USER=5
# beta14 下载速率检测（access 域）：窗口内超过阈值次数即记录异常速率，不替代分级限流
DOWNLOAD_VELOCITY_WINDOW_SECONDS=300
DOWNLOAD_VELOCITY_WINDOW_COUNT=30
# beta14 热门排序时间衰减（catalog/推荐域）：按资料创建时间计算年龄
HOT_SCORE_TIME_DECAY_DAYS=14
HOT_SCORE_DECAY_POWER=1.5
